{
  // Run via: Command Palette → "Tasks: Run Task"  (build task: Ctrl/Cmd+Shift+B)
  "version": "2.0.0",
  "tasks": [
    {
      "label": "New page",
      "detail": "建立中文新頁；兩份章節清單、日期（與開啟英文版後的英文檔）都會自動產生",
      "type": "shell",
      "command": "python3",
      "windows": { "command": "python" },
      "args": ["tools/new_page.py", "${input:pageTitle}", "--slug=${input:slug}", "--part=${input:partId}", "--level=${input:level}"],
      "problemMatcher": []
    },
    {
      "label": "Sync book",
      "detail": "依中文頁重建兩份章節清單、建立/修改日期（英文版開啟後也建立英文檔存根）",
      "type": "shell",
      "command": "python3",
      "windows": { "command": "python" },
      "args": ["tools/sync.py"],
      "problemMatcher": []
    },
    {
      "label": "Translation: status",
      "detail": "列出每一頁英文翻譯的狀態（英文版未開啟時不做事）",
      "type": "shell",
      "command": "python3",
      "windows": { "command": "python" },
      "args": ["tools/check_translations.py"],
      "problemMatcher": []
    },
    {
      "label": "Translation: export AI batch",
      "detail": "把所有待翻成英文的頁面匯出成一份 _translation-batch.md，貼給 AI",
      "type": "shell",
      "command": "python3",
      "windows": { "command": "python" },
      "args": ["tools/check_translations.py", "--export-batch"],
      "problemMatcher": []
    },
    {
      "label": "Translation: mark current file as AI draft",
      "detail": "標記目前這份英文檔為 AI 初稿（網站會顯示未審閱提示）",
      "type": "shell",
      "command": "python3",
      "windows": { "command": "python" },
      "args": ["tools/check_translations.py", "--mark-draft", "${file}"],
      "problemMatcher": []
    },
    {
      "label": "Translation: stamp current file as reviewed",
      "detail": "我已審閱這份英文檔",
      "type": "shell",
      "command": "python3",
      "windows": { "command": "python" },
      "args": ["tools/check_translations.py", "--stamp", "${file}"],
      "problemMatcher": []
    },
    {
      "label": "Translation: stamp ALL pending as reviewed",
      "detail": "批次審核完成後一次蓋章（會把所有待審頁面標記為已審閱）",
      "type": "shell",
      "command": "python3",
      "windows": { "command": "python" },
      "args": ["tools/check_translations.py", "--stamp-all"],
      "problemMatcher": []
    },
    {
      "label": "Build and serve",
      "detail": "整站建置後啟動 localhost:8000；之後存檔會自動重新 render 該頁並重新整理瀏覽器",
      "type": "shell",
      "command": "python3",
      "windows": { "command": "python" },
      "args": ["tools/build.py", "--serve"],
      "isBackground": true,
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    }
  ],
  "inputs": [
    {
      "id": "pageTitle",
      "type": "promptString",
      "description": "新頁面的標題，例如 命令列基礎"
    },
    {
      "id": "slug",
      "type": "promptString",
      "description": "英文代稱，會成為檔名與網址，例如 command-line-basics"
    },
    {
      "id": "partId",
      "type": "promptString",
      "description": "屬於 book.yml 裡的哪個 part id，也就是放進哪個資料夾（留空 = 不分區）",
      "default": "basics"
    },
    {
      "id": "level",
      "type": "pickString",
      "description": "章節程度（之後可在 front matter 的 level: 修改）",
      "options": ["basic", "beginner", "intermediate", "advanced"],
      "default": "basic"
    }
  ]
}
